# Executive Mochi – Environment Variables
# Copy this file to .env.local and fill in the values

# ─────────────────────────────────────────────
# DATABASE (Required)
# Obtain from Neon / Supabase / Vercel Postgres
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ─────────────────────────────────────────────
# AUTHENTICATION (NextAuth v5)
# Generate a secret: openssl rand -hex 32
# ─────────────────────────────────────────────
AUTH_SECRET="your-32-char-secret-here"
AUTH_URL="http://localhost:3000"

NEXTAUTH_SECRET="your-32-char-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="Executive Mochi"
NEXT_PUBLIC_BRAND_PHONE="+92-300-XXXXXXX"

# ─────────────────────────────────────────────
# CLOUDFLARE R2 OBJECT STORAGE (Product Image Uploads)
# S3-compatible bucket via Cloudflare R2
# ─────────────────────────────────────────────
S3_ENDPOINT="https://c678cf5c0fc5ef3806edacc18e6a762d.r2.cloudflarestorage.com/emochipk"
S3_REGION="auto"
S3_BUCKET_NAME="emochipk"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Direct Cloudflare R2 Public CDN Domain (Optional - 0 Vercel bandwidth usage, e.g. https://images.executivemochi.pk or https://pub-xxx.r2.dev)
NEXT_PUBLIC_IMAGE_URL=""

# ─────────────────────────────────────────────
# GOOGLE MERCHANT CENTER (Content API v2.1)
# ─────────────────────────────────────────────
GMC_MERCHANT_ID=""
GMC_CLIENT_EMAIL=""
GMC_PRIVATE_KEY=""
GMC_TARGET_COUNTRY="PK"
GMC_CONTENT_LANGUAGE="en"
GMC_CURRENCY="PKR"

# ─────────────────────────────────────────────
# GOOGLE CLOUD STORAGE (Product Images) – Legacy
# ─────────────────────────────────────────────
GCS_PROJECT_ID=""
GCS_BUCKET_NAME=""
GCS_CLIENT_EMAIL=""
GCS_PRIVATE_KEY=""

# ─────────────────────────────────────────────
# COURIER APIs (Section 4.3 – IF-SW-04 to 07)
# ─────────────────────────────────────────────
LEOPARDS_API_KEY=""
LEOPARDS_API_PASSWORD=""

POSTEX_API_TOKEN=""
POSTEX_PICKUP_ADDRESS_CODE=""

TRAX_USERNAME=""
TRAX_PASSWORD=""
TRAX_ACCOUNT_NO=""

TRACKINGMORE_API_KEY=""  # Third-party aggregator for Pakistan Post tracking

TCS_API_KEY=""
TCS_CLIENT_ID=""
TCS_COST_CENTER_CODE=""
TCS_ORIGIN_CITY="SIALKOT"
TCS_BASE_URL="https://developer.tcscourier.com/api/v1"  # Use https://sandbox.tcscourier.com for UAT

# ─────────────────────────────────────────────
# PAYMENT GATEWAYS (Section 4.3 – IF-SW-01 to 03)
# ─────────────────────────────────────────────
SAFEPAY_API_KEY=""
SAFEPAY_WEBHOOK_SECRET=""

JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""

# ─────────────────────────────────────────────
# SMS / WHATSAPP GATEWAY (COD Verification)
# ─────────────────────────────────────────────
SMS_GATEWAY_API_KEY=""
SMS_GATEWAY_SENDER_ID=""
WHATSAPP_GATEWAY_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ─────────────────────────────────────────────
# ADMIN SEED CREDENTIALS (used only in seed.ts)
# ─────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@executivemochi.pk"
SEED_ADMIN_PASSWORD="ChangeMe@123"
SEED_ADMIN_NAME="Executive Mochi Admin"

# ─────────────────────────────────────────────
# META CONVERSIONS API (Server-side pixel)
# Pixel ID is public — access token is SECRET, never commit it
# Get token: Meta Events Manager → your Pixel → Settings → Generate access token
# ─────────────────────────────────────────────
META_PIXEL_ID="2488482501579231"
META_CAPI_ACCESS_TOKEN=""
# Optional: set this during testing in Meta Events Manager → Test Events
META_CAPI_TEST_CODE=""
